# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_PATH=./data/app.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGIN=http://localhost:5173

# OSRM routing (public demo server)
OSRM_BASE_URL=https://router.project-osrm.org

# Super Admin account (automatically created on database initialization; logs in via email OTP)
SUPER_ADMIN_EMAIL=vinay_227051@saitm.org

# Clerk (https://dashboard.clerk.com) - required to verify Clerk email-code sessions server-side.
# Get the secret key from Dashboard -> API Keys. Keep it out of the frontend.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Email OTP delivery -----
# EMAIL_PROVIDER options:
#   console - print OTP to server logs (development only)
#   resend - Resend API (free tier: 3,000 emails/month). Requires RESEND_API_KEY.
#   smtp   - any SMTP host (e.g. Gmail app password, Brevo free 300/day).
#            Requires SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS (and optionally SMTP_SECURE).
EMAIL_PROVIDER=console
MAIL_FROM=Nextdoor Rewari <onboarding@resend.dev>

# Resend (https://resend.com)
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# SMTP (e.g. Gmail: smtp.gmail.com, 465, SMTP_SECURE=true; use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
