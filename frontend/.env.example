# API base URL. In development the Vite dev server proxies /api to localhost:4000,
# so leave this empty. For a deployed frontend set it to your API origin.
VITE_API_URL=

# App display name (PWA manifest + config)
VITE_APP_NAME=Nextdoor

# Rewari map center (used when geolocation is unavailable)
VITE_REWARI_CENTER_LAT=28.1928
VITE_REWARI_CENTER_LNG=76.6186

# OpenStreetMap tile provider
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
